<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <EditorOutput>$(MSBuildThisFileDirectory)..\..\GRFEditor\bin\Debug\</EditorOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GRF Editor"><HintPath>$(EditorOutput)GRF Editor.exe</HintPath></Reference>
    <Reference Include="Utilities"><HintPath>$(EditorOutput)Utilities.dll</HintPath></Reference>
    <Reference Include="TokeiLibrary"><HintPath>$(EditorOutput)TokeiLibrary.dll</HintPath></Reference>
    <Reference Include="GrfToWpfBridge"><HintPath>$(EditorOutput)GrfToWpfBridge.dll</HintPath></Reference>
    <Reference Include="GRF"><HintPath>$(EditorOutput)GRF.dll</HintPath></Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <Target Name="CopyEditorDependencies" AfterTargets="Build">
    <ItemGroup>
      <EditorDlls Include="$(EditorOutput)*.dll" />
      <KoreanResources Include="$(EditorOutput)ko\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorDlls)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KoreanResources)" DestinationFolder="$(TargetDir)ko" SkipUnchangedFiles="true" />
  </Target>
</Project>
