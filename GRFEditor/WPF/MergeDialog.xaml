<Styles:TkWindow xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.MergeDialogCustom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
		xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
		Background="{StaticResource TabItemBackground}" Foreground="{StaticResource TextForeground}">
	<StackPanel>
        <TextBlock Margin="3" Text="{loc:Localize T7c78390b3e9a}" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label Content="{loc:Localize T0623ae4142cc}" VerticalAlignment="Center" />
            <Label Content="{loc:Localize Ta802530e462e}" VerticalAlignment="Center" Grid.Row="1" />
            <Styles:PathBrowser BrowseMode="File"  Name="_pathBrowserOldGrf" Filter="Container Files|*.grf;*.gpf;*.thor;" TextChanged="_pathBrowserOldGrf_TextChanged" Grid.Column="1" UseSavePath="True" SavePathUniqueName="GRFEditor - Merge old - " MaxWidth="350" MinWidth="350" />
			<Styles:PathBrowser BrowseMode="File" Name="_pathBrowserNewGrf" Filter="Container Files|*.grf;*.gpf;*.thor;*.gsf" TextChanged="_pathBrowserNewGrf_TextChanged" Grid.Row="1" Grid.Column="1" UseSavePath="True" SavePathUniqueName="GRFEditor - Merge new - " MaxWidth="350" MinWidth="350" />
            <Styles:TkProgressBar x:Name="_progressBarComponent" Grid.Row="3" Grid.Column="1" Margin="3" />
        </Grid>
        <Grid TokeiLibrary:WpfProperties.IsDraggable="True" Height="40" Background="{DynamicResource UIDialogBackground}">
            <Grid Margin="0 0 3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="2">
                    <Button  Name="_buttonOK" Content="{loc:Localize Tea8f0d02371e}" Width="100" Height="24" Margin="3" Click="_buttonOK_Click" />
                    <Button HorizontalAlignment="Right" Name="_buttonCancel" Content="{loc:Localize Tbbfa773e5a63}" Width="100" Height="24" Margin="3" Click="_buttonCancel_Click" />
                </DockPanel>
            </Grid>
        </Grid>
    </StackPanel>
</Styles:TkWindow>