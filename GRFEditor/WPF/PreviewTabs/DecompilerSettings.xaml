<PreviewTabs:FilePreviewTab xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.PreviewTabs.DecompilerSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:PreviewTabs="clr-namespace:GrfToWpfBridge.PreviewTabs;assembly=GrfToWpfBridge"
			 mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Foreground="{StaticResource TextForeground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Name="_labelHeader" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" Padding="5" />
            <WrapPanel>
                <StackPanel VerticalAlignment="Center">
                </StackPanel>
            </WrapPanel>
            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
        </StackPanel>
        <Grid Grid.Row="1">
            <StackPanel>
                <StackPanel>
                    <CheckBox Name="_cbUseCodeReconstructor" Content="{loc:Localize T179898d367c4}" Margin="3">
                        <CheckBox.ToolTip><TextBlock Text="{loc:Localize Te6cdc62e4ff6}" /></CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox Name="_cbUseDefaultDecompiler" Content="{loc:Localize Tcd59e7d8db85}" Margin="3" IsEnabled="False" IsChecked="True" />
                </StackPanel>
                <StackPanel>
                    <Label Content="{loc:Localize T841f832857c7}" FontWeight="Bold" FontSize="14" Margin="3 5 0 0" />
                    <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
                    <CheckBox Name="_cbShowGrfHeader" Content="{loc:Localize Tc808e7702054}" Margin="3">
                        <CheckBox.ToolTip><TextBlock Text="{loc:Localize Tac5ed236c5f1}" /></CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox Name="_cbFunctionNumber" Content="{loc:Localize T2afbafd8c941}" Margin="3">
                        <CheckBox.ToolTip><TextBlock Text="{loc:Localize Tdb921d6e7cd9}" /></CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox Name="_cbGroupAllValues" Content="{loc:Localize Ta33266184165}" Margin="3">
                        <CheckBox.ToolTip><TextBlock Text="{loc:Localize T84a05bae835b}" /></CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox Name="_cbGroupAllKeyValues" Content="{loc:Localize Tede8688adfd5}" Margin="3">
                        <CheckBox.ToolTip>
                            Always group dictionaries if the items are all key values > dico = { ex = 20, ex2 = 30 }.
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <DockPanel HorizontalAlignment="Left">
                        <Label Content="{loc:Localize T097d49d7b8d0}" />
                        <TextBox Name="_tbTextLengthLimit" Width="70" Margin="3" />
                    </DockPanel>
                </StackPanel>
                <StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2">
            <Label Content="{loc:Localize T3c063438765b}" FontWeight="Bold" FontSize="14" Margin="3 5 0 0" />
            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
        </StackPanel>
        <TextBox Name="_tbConsole" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True" HorizontalScrollBarVisibility="Visible" FontFamily="Courier New">
        </TextBox>
    </Grid>
</PreviewTabs:FilePreviewTab>
