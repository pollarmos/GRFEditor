<UserControl xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.PreviewTabs.PreviewContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:WPF="clr-namespace:TokeiLibrary.WPF;assembly=TokeiLibrary"
			 xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
             xmlns:Application="clr-namespace:GrfToWpfBridge.Application;assembly=GrfToWpfBridge"
             xmlns:GRF="clr-namespace:GRF.Core;assembly=GRF"
			 mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300" Foreground="{DynamicResource TextForeground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel>
			<TextBlock Name="_labelHeader" FontWeight="Bold" Text="{loc:Localize T79d17e1264d7}" FontSize="16" Margin="3 10 0 5" Padding="5" />
            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
            <Label Content="{loc:Localize Tad59532306c2}" FontWeight="Bold" FontSize="14" Margin="3 10 0 5" />
            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
            <Grid Margin="6 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition MaxWidth="250" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Localize T84577493559f}" Margin="3" Grid.Row="0" VerticalAlignment="Center" >
                    <TextBlock.ToolTip>
                        <TextBlock Text="{loc:Localize Ta4e2cc8f9dd8}" />
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Text="{loc:Localize T104224fd928b}" Margin="3" Grid.Row="1" VerticalAlignment="Center" >
                    <TextBlock.ToolTip>
                        <TextBlock Text="{loc:Localize Tbab52926356f}" />
                    </TextBlock.ToolTip>
                </TextBlock>

                <Application:EncodingPicker Grid.Column="1" Grid.Row="1" Margin="3" Name="_comboBoxEncoding" Width="150" HorizontalAlignment="Left" IsReadOnly="True" />
                <TextBox VerticalContentAlignment="Center" Height="24" IsReadOnly="True" Name="_textBoxSourceFileName" Margin="3" Grid.Column="1" />
            </Grid>
			<Label Name="_labelPropertyType" Content="{loc:Localize Tf182044fb05c}" FontWeight="Bold" FontSize="14" Margin="3 10 0 5" />
            <Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
            <Grid>
                <Grid Margin="6 0 0 0" Name="_gridGrf" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{loc:Localize T11d5f4e2d1c1}" Margin="3" Grid.Row="2" VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <TextBlock Text="{loc:Localize T0eba8262170c}" />
                        </TextBlock.ToolTip>
                    </TextBlock>

                    <TextBlock Text="{loc:Localize Tff9b3910e086}" Margin="3" Grid.Row="3" VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <TextBlock><Run Text="{loc:Localize T2066ffcfec11}" /><LineBreak /><Run Text="{loc:Localize T1de91cc9bcaa}" /></TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>

					<ComboBox Grid.Row="2" Grid.Column="1" Name="_comboBoxFormat" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3" ItemsSource="{Binding Source={x:Static GRF:GrfFormatViews.Formats}}" />

					<DockPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" >
                        <TextBox Width="150" Height="24" Name="_tbMagicHeader" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="3" IsReadOnly="true" />
                        <Button Margin="3" Height="24" Name="_buttonMagicEdit" Content="{loc:Localize T59c4425fb53c}" Width="50" Click="_buttonMagicEdit_Click" />
                        <Button Margin="3" Height="24" Name="_buttonMagicReset" Content="{loc:Localize T44c57abd888a}" Width="50" Click="_buttonMagicReset_Click" />
                    </DockPanel>
                </Grid>
                <Grid Margin="6 0 0 0" Name="_gridThor" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition MaxWidth="250" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="_tbTarget" Visibility="Collapsed" Text="{loc:Localize T8b2c2015cb44}" Margin="3" Grid.Row="1" VerticalAlignment="Center" >
                        <TextBlock.ToolTip>
                            <TextBlock Text="{loc:Localize Tac2310991a49}" />
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock Text="{loc:Localize T6c3c570aa7de}" Margin="3" Grid.Row="0" VerticalAlignment="Center" />
					<TextBox Height="24" VerticalContentAlignment="Center" Name="_textBoxTargetGrf" Visibility="Collapsed" Grid.Row="1" Grid.Column="1" Margin="3" TextChanged="_textBoxTargetGrf_TextChanged" />
					<WPF:TkInfoBlock VerticalContentAlignment="Center" Height="24" x:Name="_tkInfo" Margin="3" Visibility="Collapsed" Grid.Row="2" Text="{loc:Localize Tf097bd3cf789}" TokeiLibrary:WpfProperties.ImagePath="help.png" Grid.Column="0" Grid.ColumnSpan="2" />
					<ComboBox Grid.Row="0" Grid.Column="1" Width="160" HorizontalAlignment="Left" Name="_comboBoxPatchMode" SelectedIndex="0" VerticalAlignment="Center" Margin="3" SelectionChanged="_comboBoxPatchMode_SelectionChanged" >
                        <ComboBoxItem Content="{loc:Localize T27045b7ab7cf}" />
                        <ComboBoxItem Content="{loc:Localize T4bf9292d5044}" />
                    </ComboBox>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
