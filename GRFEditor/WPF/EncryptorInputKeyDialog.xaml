<Styles:TkWindow xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.EncryptorInputKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
	    MinWidth="450" MaxWidth="450" Background="{StaticResource TabItemBackground}" Foreground="{StaticResource TextForeground}">
    <StackPanel>
        <StackPanel Margin="0 3 3 3">
            <TextBlock Name="_tbInfo" Text="{loc:Localize T0eb5ed506e49}" TextWrapping="Wrap" Margin="5" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Grid.Row="1" Grid.Column="0" Content="{loc:Localize T20dfe9cb6258}" VerticalAlignment="Center" />
                <TextBox Name="_tbEncryptionPassword" VerticalContentAlignment="Center" TextChanged="_tbEncryptionPassword_TextChanged" Grid.Row="1" Grid.Column="1" Margin="3" MaxLength="250" Height="24" />
                <Styles:ButtonMenu Content="{loc:Localize T55080a5e69b1}" Margin="2" Grid.Column="2" Grid.Row="1" Width="40" Height="24">
                    <Styles:ButtonMenu.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Localize T719ea396ad92}" Click="_miClear_Click" />
                            <MenuItem Header="{loc:Localize T96b41bc1a37e}" Click="_miSave_Click" />
                            <MenuItem Header="{loc:Localize Tf6c0bcf862c9}"  Click="_miLoad_Click" />
                            <MenuItem x:Name="_miLoadRecent" Header="{loc:Localize Tb2bdbbd77961}" IsEnabled="False" />
                        </ContextMenu>
                    </Styles:ButtonMenu.ContextMenu>
                </Styles:ButtonMenu>
            </Grid>
        </StackPanel>
		<Grid TokeiLibrary:WpfProperties.IsDraggable="True" Height="40" Background="{DynamicResource UIDialogBackground}">
            <DockPanel HorizontalAlignment="Right" Margin="0 0 3 0">
                <Button Name="_buttonOk" Content="{loc:Localize T81bdfd65c4ba}" Width="100" Height="24" Margin="3" Click="_buttonOk_Click" />
                <Button Name="_buttonCancel" Content="{loc:Localize T77dfd2135f4d}" Width="100" Height="24" Margin="3" Click="_buttonCancel_Click" />
            </DockPanel>
        </Grid>
    </StackPanel>
</Styles:TkWindow>