<Styles:TkWindow xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.AddFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" Drop="Window_Drop"
                 xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
                 xmlns:WPF="clr-namespace:TokeiLibrary.WPF;assembly=TokeiLibrary"
                 xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary" MinWidth="450" MaxWidth="450" Background="{DynamicResource TabItemBackground}" Foreground="{DynamicResource TextForeground}">
    <StackPanel>
        <TextBlock TextWrapping="Wrap" Text="{loc:Localize T0c980556ea59}" Margin="3" />
        <WPF:TkView Name="_treeView" Height="200" SelectedItemChanged="_treeView_SelectedItemChanged" />
        <DockPanel>
            <Label Width="130" Content="{loc:Localize T33609930bb5d}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBox Name="_textBoxSourceFile" Margin="3 3 0 3" TextChanged="_textBoxSourceFile_TextChanged" />
                <Button Name="_buttonFolderBrowse" Grid.Column="1" Content="{loc:Localize T805b0f5e4349}" Width="40" Margin="3" Click="_buttonFolderBrowse_Click" />
                <Button Name="_buttonFileBrowse" Grid.Column="2" Content="{loc:Localize T04c58b8a2219}" Width="40" Margin="3" Click="_buttonFileBrowse_Click" />
            </Grid>
        </DockPanel>
        <DockPanel>
            <Label Width="130" Content="{loc:Localize T0e9d6b4b58b0}" />
            <TextBox Name="_textBoxGrfPath" Margin="3 3 0 3" IsReadOnly="True" />
        </DockPanel>
        <Grid TokeiLibrary:WpfProperties.IsDraggable="True" Height="40" Background="{DynamicResource UIDialogBackground}">
            <Grid Margin="0 0 3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="2">
                    <Button  Name="_buttonOK" Content="{loc:Localize T61cc55aa0453}" Width="100" Height="24" Margin="3" Click="_buttonOK_Click" />
                    <Button  Name="_buttonCancel" Content="{loc:Localize T77dfd2135f4d}" Width="100" Height="24" Margin="3" Click="_buttonCancel_Click" />
                </DockPanel>
            </Grid>
        </Grid>
    </StackPanel>
</Styles:TkWindow>
