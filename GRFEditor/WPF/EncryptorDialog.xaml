<Styles:TkWindow xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.EncryptorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
        MinWidth="550" MaxWidth="550" Background="{StaticResource TabItemBackground}" Foreground="{StaticResource TextForeground}" SnapsToDevicePixels="True">
    <StackPanel>
        <StackPanel>
            <StackPanel>
                <Border BorderBrush="{StaticResource EncryptionDialogBorderBrush}" CornerRadius="3" BorderThickness="2" Margin="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="{loc:Localize T20dfe9cb6258}" VerticalAlignment="Center" />
                        <Label VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Content="{loc:Localize T0bd2c6f3cf91}" />
                        <Label VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Content="{loc:Localize Tde18c89ed726}" />
                        <Label VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Content="{loc:Localize T80541c2b3b95}" />
                        <Label VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Content="{loc:Localize Tf2690f8c3f93}" />
                        
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="_tbEncryptionPassword" TextChanged="_tbEncryptionPassword_TextChanged" Grid.Row="0" Grid.Column="0" Margin="3" Height="24" VerticalContentAlignment="Center" />
                            <Styles:ButtonMenu Content="{loc:Localize T55080a5e69b1}" Margin="3" Grid.Column="1" Width="75" Height="24">
                                <Styles:ButtonMenu.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Localize T719ea396ad92}" Click="_miClear_Click" />
                                        <MenuItem Header="{loc:Localize T96b41bc1a37e}" Click="_miSave_Click" />
                                        <MenuItem Header="{loc:Localize Tf6c0bcf862c9}"  Click="_miLoad_Click" />
                                        <MenuItem x:Name="_miLoadRecent" Header="{loc:Localize Tb2bdbbd77961}" IsEnabled="False" />
                                    </ContextMenu>
                                </Styles:ButtonMenu.ContextMenu>
                            </Styles:ButtonMenu>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Styles:PathBrowser BrowseMode="File" UseSavePath="True" SavePathUniqueName="GRFEditor - Client path"  TextBox.TextChanged="_tbClientPath_TextChanged" Name="_tbClientPath" Text="" />
                        </Grid>
                        <CheckBox Name="_cbRenameCps" Margin="3" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <CheckBox Name="_cbIgnoreMissingResources" Margin="3" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" />

                        <Grid Grid.Row="4" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Name="_tbUncompressName" Margin="3" IsReadOnly="True" Height="24" VerticalContentAlignment="Center" />
                            <Button Name="_tbCopyUncompress" Click="_tbCopyUncompress_Click" Grid.Column="1" Width="75" Height="24" Margin="3" Content="{loc:Localize Taf74f7c5362a}" />
                        </Grid>
                    </Grid>
                </Border>
				<TextBlock Margin="3 0 3 3" TextWrapping="Wrap"><Run Text="{loc:Localize T20eabc00f6a7}" /><LineBreak />
                    <LineBreak /><Run Text="{loc:Localize T3f7f98fab2dd}" /><LineBreak />
                    <LineBreak /><Run Text="{loc:Localize T42d8a3d62eb5}" /><LineBreak />
                    <LineBreak /><Run Text="{loc:Localize T4efb8f002696}" /></TextBlock>
			</StackPanel>
        </StackPanel>
		<Grid TokeiLibrary:WpfProperties.IsDraggable="True" Height="40" Background="{DynamicResource UIDialogBackground}">
            <DockPanel HorizontalAlignment="Right" Margin="0 0 3 0">
                <Button Name="_buttonGenerateClientConf" Click="_buttonGenerateClientConf_Click" Grid.Row="6" Grid.Column="1" Content="{loc:Localize T9b772b08bd49}" Margin="3" Width="100" Height="24" HorizontalAlignment="Right" />
                <Button Name="_buttonCancel" Content="{loc:Localize Tbbfa773e5a63}" Width="100" Height="24" Margin="3" Click="_buttonCancel_Click" />
            </DockPanel>
        </Grid>
    </StackPanel>
</Styles:TkWindow>