<Styles:TkWindow xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.PatcherDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
		Background="{StaticResource TabItemBackground}" Foreground="{StaticResource TextForeground}">
    <StackPanel>
        <TextBlock Margin="3" Text="{loc:Localize Td2f6f10c1275}" Grid.Row="1" TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label Content="{loc:Localize T48be43b380c8}" VerticalAlignment="Center" />
            <Label Content="{loc:Localize Tf2cdeb4eb917}" VerticalAlignment="Center" Grid.Row="1" />
            <Styles:PathBrowser BrowseMode="File"  Name="_pathBrowserOldGrf" Filter="Container Files|*.grf;*.gpf;*.thor" TextChanged="_pathBrowserOldGrf_TextChanged" UseSavePath="True" SavePathUniqueName="GRFEditor - Patch old - " MaxWidth="350" MinWidth="350" Grid.Column="1" />
			<Styles:PathBrowser BrowseMode="File" Name="_pathBrowserNewGrf" Filter="Container Files|*.grf;*.gpf;*.thor;*.gsf" TextChanged="_pathBrowserNewGrf_TextChanged" UseSavePath="True" SavePathUniqueName="GRFEditor - Patch old - " MaxWidth="350" MinWidth="350" Grid.Row="1" Grid.Column="1" />
            <Styles:TkProgressBar x:Name="_progress" Grid.Row="3" Grid.Column="1" Margin="3" />
            <Label Grid.Row="2" Content="{loc:Localize T1933aa9ff723}" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="_textBoxOutputName" Text="" Margin="3" MinHeight="24" VerticalContentAlignment="Center" />
        </Grid>
        <Grid TokeiLibrary:WpfProperties.IsDraggable="True" Grid.Row="2" Height="40" Background="{DynamicResource UIDialogBackground}">
            <Grid Margin="0 0 3 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="2">
                    <Button  Name="_buttonOK" Content="{loc:Localize T190aa842474f}" Width="100" Height="24" Margin="3" Click="_buttonOK_Click" />
                    <Button HorizontalAlignment="Right" Content="{loc:Localize T77dfd2135f4d}" Width="100" Height="24" Margin="3" Click="_buttonClose"/>
                </DockPanel>
            </Grid>
        </Grid>
    </StackPanel>
</Styles:TkWindow>
