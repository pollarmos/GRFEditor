<PreviewTabs:FilePreviewTab xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.WPF.PreviewTabs.PreviewMapGat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:WPF="clr-namespace:GRFEditor.WPF"
             xmlns:ApplicationConfiguration="clr-namespace:GRFEditor.ApplicationConfiguration"
             xmlns:PreviewTabs="clr-namespace:GrfToWpfBridge.PreviewTabs;assembly=GrfToWpfBridge"
             xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary" mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Foreground="{DynamicResource TextForeground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel>
			<TextBlock Name="_labelHeader" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" Padding="5" />
			<Rectangle Margin="5 0 5 5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
            <WrapPanel Grid.Row="0" >
                <Grid Width="120" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{loc:Localize T5eadd20cb963}" HorizontalAlignment="Center" Margin="3" Padding="0" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Margin="3" VerticalAlignment="Center" SelectedIndex="0" Name="_cbPreviewMode" >
                        <ComboBoxItem Content="{loc:Localize Tb575466377d5}" />
                        <ComboBoxItem Content="{loc:Localize T56239f786dd5}" />
                        <ComboBoxItem Content="{loc:Localize T06a12f9a4505}" />
                        <ComboBoxItem Content="{loc:Localize Ta36ef8aba229}" />
                        <ComboBoxItem Content="{loc:Localize Taa0e7e86b7aa}" />
                        <!--<ComboBoxItem Content="{loc:Localize T7e9afd079fbd}" />-->
                    </ComboBox>
                </Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <CheckBox Name="_cbRescale" Grid.Row="0" Margin="3" Content="{loc:Localize T5671f348fbc9}" VerticalAlignment="Center" />
                    <CheckBox Name="_cbHideBorders" Grid.Row="1" Margin="3" Content="{loc:Localize T99e1cc6fe181}" VerticalAlignment="Center" />
                    <CheckBox Name="_cbTransparent" Grid.Row="2" Margin="3" Content="{loc:Localize T4ab4dc9e9014}" VerticalAlignment="Center" />
                </Grid>
                <!--<Grid Width="120">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                    </Grid>-->
                <Styles:FancyButton x:Name="_buttonSaveInGrf" Click="_buttonSaveInGrf_Click" TextHeader="{loc:Localize Tdd05c250ce53}" TextDescription="{loc:Localize Te1baa00ff58b}" VerticalAlignment="Center"  />
                <Grid HorizontalAlignment="Left" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Localize T64dd60fe1a04}" Margin="3" Width="100" TextAlignment="Center" TextWrapping="Wrap" />
                    <WPF:QuickColorSelector Height="20" Margin="3" x:Name="_qcsBackground" Grid.Row="1" ColorBrush="{Binding ElementName=_scrollViewer, Path=Background}" />
                </Grid>
            </WrapPanel>
            <Rectangle Margin="5" Stroke="{DynamicResource SeperatorBrush}" VerticalAlignment="Stretch" />
        </StackPanel>
        <Grid  Grid.Row="2" RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Grid.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <Grid>
                            <Image Source="../../Resources/background.png" RenderOptions.BitmapScalingMode="NearestNeighbor" Width="256" Height="256" />
                        </Grid>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
            <ScrollViewer Background="{x:Static ApplicationConfiguration:GrfEditorConfiguration.UIPanelPreviewBackground}" Name="_scrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" Grid.Row="2">
                <DockPanel Name="_dockPanelImages">
                    <DockPanel DockPanel.Dock="Top" />
                    <Image Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True" Name="_imagePreview" Stretch="None" RenderTransformOrigin="0.5,0.5">
                        <Image.ContextMenu>
                            <ContextMenu>
                                <MenuItem Name="_menuItemImageExport" Header="{loc:Localize T6ab60c3ebb4b}" Click="_menuItemImageExport_Click">
                                    <MenuItem.Icon>
                                        <Image Source="../../Resources/export.png" Height="16"  />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Image.ContextMenu>
                        <Image.RenderTransform>
                            <TransformGroup>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </DockPanel>
            </ScrollViewer>
        </Grid>
		<PreviewTabs:ErrorPanel x:Name="_errorPanel" />
    </Grid>
</PreviewTabs:FilePreviewTab>
