<Styles:TkWindow xmlns:loc="clr-namespace:TokeiLibrary.Localization;assembly=TokeiLibrary" x:Class="GRFEditor.Tools.SpriteEditor.SpriteConverter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AllowDrop="False"
                 xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
                 xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
                 xmlns:SpriteEditorConfiguration="clr-namespace:GRFEditor.Tools.SpriteEditor"
                 xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
				 ShowInTaskbar="True" SnapsToDevicePixels="True" UseLayoutRounding="True"
				 Background="{DynamicResource TabItemBackground}" Foreground="{DynamicResource TextForeground}">
    <Grid AllowDrop="True" DragEnter="_presenter_DragEnter" Drop="_presenter_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Menu Margin="0 0 0 0" Height="30">
            <MenuItem VerticalAlignment="Center">
                <MenuItem.Header>
                    <Label Content="{loc:Localize T2c3cafa4db3f}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
                </MenuItem.Header>
				<MenuItem Click="_menuItemNew_Click" TokeiLibrary:WpfProperties.ImagePath="add.png" Name="_menuItemNew" Header="{loc:Localize T6403f2b7eb2a}" />
				<MenuItem Click="_menuItemOpen_Click" TokeiLibrary:WpfProperties.ImagePath="newFile.png" Name="_menuItemOpen" Header="{loc:Localize Tcf9b77061f7b}" />
				<MenuItem IsEnabled="False" TokeiLibrary:WpfProperties.ImagePath="empty.png" Name="_menuItemRecent" Header="{loc:Localize T12b32b12bc37}" />
				<Separator />
				<MenuItem Click="_menuItemCloseSprite_Click" TokeiLibrary:WpfProperties.ImagePath="empty.png" Name="_menuItemCloseSprite" Header="{loc:Localize Tc8f6088474c5}" />
				<Separator />
				<MenuItem Click="_menuItemSave_Click" TokeiLibrary:WpfProperties.ImagePath="save.png" Name="_menuItemSave" Header="{loc:Localize Tefc007a393f6}" />
				<MenuItem Click="_menuItemSaveAs_Click" TokeiLibrary:WpfProperties.ImagePath="empty.png" Name="_menuItemSaveAs" Header="{loc:Localize Tc8182796561f}" />
				<MenuItem Click="_menuItemExportAll_Click" TokeiLibrary:WpfProperties.ImagePath="empty.png" Name="_menuItemExportAll" Header="{loc:Localize Tbd6774a82ff4}" />
				<MenuItem Click="_menuItemClose_Click" TokeiLibrary:WpfProperties.ImagePath="empty.png" Name="_menuItemClose" Header="{loc:Localize Tbbfa773e5a63}" />
			</MenuItem>
            <MenuItem VerticalAlignment="Center">
                <MenuItem.Header>
                    <Label Content="{loc:Localize T6bf5da9c080b}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
                </MenuItem.Header>
                <MenuItem Name="_menuItem" Header="{loc:Localize Tbd6f1035d281}">
					<MenuItem Name="_menuItemPalView" Click="_menuItemPalView_Click" Header="{loc:Localize T69bd4ef9fbd0}" />
					<MenuItem Name="_menuItemPalReplaceWith" Click="_menuItemPalReplaceWith_Click" Header="{loc:Localize T2d24407a91a8}" />
					<MenuItem Name="_menuItemPalReplaceDefault" Click="_menuItemPalReplaceDefault_Click" Header="{loc:Localize T987583ea4e68}" />
					<MenuItem Name="_menuItemPalClear" Click="_menuItemPalClear_Click" Header="{loc:Localize T719ea396ad92}" />
				</MenuItem>
				<MenuItem Foreground="{DynamicResource TextForeground}" Name="_cbUseTga" Header="{loc:Localize T72499765528c}" IsCheckable="True" Margin="3" IsChecked="{Binding Path=(SpriteEditorConfiguration:SpriteEditorConfiguration.UseTgaImages), Mode=TwoWay}" />
            </MenuItem>
            <MenuItem>
                <MenuItem.Header>
                    <Label Content="{loc:Localize Tc47ae15370cf}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5 0 -5 0" />
                </MenuItem.Header>
				<MenuItem Name="_menuItemAbout" TokeiLibrary:WpfProperties.ImagePath="help.png" Click="_menuItemAbout_Click" Header="{loc:Localize Tcf0cf48a1185}" />
			</MenuItem>
        </Menu>
		<TabControl Background="{DynamicResource TabItemBackground}" Name="_mainTabControl" Grid.Row="1" Style="{DynamicResource TabControlSprite}" />
	</Grid>
</Styles:TkWindow>